---
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  lang: string;
  title: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const direction = lang === "ar" ? "rtl" : "ltr";
const siteBase = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang={lang} dir={direction} transition:animate="none">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080909" />
    <meta
      name="description"
      content={description ?? "Watchtower documentation for the app and its extensions."}
    />
    <link rel="icon" type="image/svg+xml" href={`${siteBase}favicon.svg`} />
    <title>{title} · Watchtower Docs</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-fd-background text-fd-foreground">
    <slot />
  </body>
</html>
