---
const landingUrl = `${import.meta.env.BASE_URL}kage.html`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Watchtower — your media library, in one place." />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>Watchtower</title>
    <style>
      :global(html, body) {
        width: 100%;
        height: 100%;
        margin: 0;
        overflow: hidden;
      }

      iframe {
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
      }
    </style>
  </head>
  <body>
    <iframe title="Watchtower landing page" src={landingUrl}></iframe>
  </body>
</html>
