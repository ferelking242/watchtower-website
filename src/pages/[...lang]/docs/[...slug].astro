---
import { Docs } from "../../../components/docs";
import type { ExtensionEntry } from "../../../components/extension-catalogue";
import catalogueData from "../../../data/extensions.json";
import Layout from "../../../layouts/Layout.astro";
import { i18n } from "../../../lib/i18n";
import { source } from "../../../lib/source";

export const prerender = true;

export function getStaticPaths() {
  const paths = [];

  for (const { language, pages } of source.getLanguages()) {
    for (const page of pages) {
      paths.push({
        params: {
          lang: language === i18n.defaultLanguage ? undefined : language,
          slug: page.slugs.join("/") || undefined,
        },
        props: { lang: language, page },
      });
    }
  }

  return paths;
}

const { lang, page } = Astro.props;
const { body: Content, toc } = await page.data.load();
const pageTree = await source.serializePageTree(source.getPageTree(lang));
const isCatalogue = page.slugs.join("/") === "extensions/catalogue";
const initialCatalogueEntries = isCatalogue
  ? ([...catalogueData.extensions]
      .filter((entry) => !entry.adult)
      .sort((left, right) => left.name.localeCompare(right.name))
      .slice(0, 24) as ExtensionEntry[])
  : [];
---

<Layout
  lang={lang}
  title={page.data.fullTitle ?? page.data.title}
  description={page.data.description}
>
  <Docs
    client:load
    transition:persist="docs"
    lang={lang}
    pathname={Astro.url.pathname}
    params={Astro.params}
    tree={pageTree}
    title={page.data.title}
    fullTitle={page.data.fullTitle}
    description={page.data.description}
    toc={isCatalogue ? [] : toc}
    isCatalogue={isCatalogue}
    initialCatalogueEntries={initialCatalogueEntries}
    catalogueCount={isCatalogue ? catalogueData.extensions.length : 0}
  >
    {!isCatalogue && <Content />}
  </Docs>
</Layout>
